    "Print single-sided if you color with markers: the photos would be on the backs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drucke einseitig, wenn du mit Filzstiften malst: Sonst wären die Fotos auf den Rückseiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime a una cara si coloreas con marcadores: las fotos quedarían en el reverso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime en recto seul si tu colories au feutre : les photos seraient au verso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーカーでぬるときは、片面で印刷してください。（両面だと、裏に写真が印刷されます）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima só de um lado se for pintar com canetinha: as fotos ficariam no verso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าระบายด้วยปากกาเมจิก ควรพิมพ์หน้าเดียว เพราะถ้าพิมพ์สองหน้า รูปถ่ายจะอยู่ด้านหลังภาพ"
          }
        }
      }
    },
