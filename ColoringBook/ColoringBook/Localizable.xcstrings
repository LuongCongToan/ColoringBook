    "No books yet. Make one from the pages you colored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Bücher. Mach eins aus deinen ausgemalten Seiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay libros. Crea uno con tus páginas coloreadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de livre. Crées-en un avec les pages que tu as coloriées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだブックがありません。ぬったページからブックを作りましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há livros. Crie um com as páginas que você pintou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสมุดเลย ลองทำจากหน้าที่ระบายสีแล้วสิ"
          }
        }
      }
    },
    "No connection. Check the internet and try again. No page was used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Prüf das Internet und versuch es noch mal. Es wurde keine Seite verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Revisa tu conexión a internet e inténtalo de nuevo. No se ha usado ninguna página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion. Vérifie Internet et réessaie. Aucune page n’a été utilisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットにつながっていません。接続を確認して、もう一度お試しください。AIぬりえは使われていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão. Verifique a internet e tente de novo. Nenhuma página foi usada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเชื่อมต่อ ตรวจสอบอินเทอร์เน็ตแล้วลองอีกครั้ง ครั้งนี้ไม่นับหน้า"
          }
        }
      }
    },
