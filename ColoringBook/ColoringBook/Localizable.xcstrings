          "stringUnit": {
            "state": "translated",
            "value": "Las personas y mascotas de cerca quedan mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes et les animaux, vus de près, donnent les meilleurs résultats."
