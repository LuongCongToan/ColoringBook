    "Color or make a page first. Pages you color appear in My pages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal zuerst eine Seite aus oder erstelle eine. Ausgemalte Seiten erscheinen unter „Meine Seiten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero colorea o crea una página. Las páginas que colorees aparecen en Mis páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorie ou crée d’abord une page. Les pages que tu colories apparaissent dans Mes pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずはページをぬるか、作ってください。ぬったページは「わたしのページ」に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
