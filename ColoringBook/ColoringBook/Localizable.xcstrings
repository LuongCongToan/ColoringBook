            "state": "translated",
            "value": "60 páginas de IA por mês, livros ilimitados. Cobrança anual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้า AI เดือนละ 60 หน้า ทำสมุดได้ไม่จำกัด เรียกเก็บเงินรายปี"
          }
        }
      }
    },
    "A face is at the edge. A photo with more space around it draws better.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gesicht ist am Rand. Mit mehr Platz drumherum wird das Bild schöner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una cara en el borde. Una foto con más espacio alrededor queda mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un visage touche le bord. Une photo avec plus d’espace autour donnera un plus beau dessin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔が写真の端にあります。まわりに余白がある写真のほうが、きれいに描けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem um rosto na borda. Uma foto com mais espaço em volta fica melhor."
