    "Waiting for approval. Drawing unlocks as soon as it goes through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Zustimmung. Das Malen wird freigeschaltet, sobald sie erteilt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Podrás dibujar en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Le dessin se débloque dès qu’elle est accordée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されるとすぐに描けるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O desenho é liberado assim que for aprovado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอการอนุมัติ จะวาดได้ทันทีที่ได้รับอนุมัติ"
          }
        }
      }
    },
