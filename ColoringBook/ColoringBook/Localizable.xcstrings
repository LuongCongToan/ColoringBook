    "3-day free trial, then %@ per year. 60 AI pages a month, unlimited books.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Tage kostenlos testen, danach %@ pro Jahr. 60 KI-Seiten im Monat, unbegrenzt viele Bücher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratis de 3 días y luego %@ al año. 60 páginas con IA al mes, libros ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit de 3 jours, puis %@ par an. 60 pages IA par mois, livres illimités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間無料、その後は年額%@。\nAIぬりえ月60枚、ブック無制限。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dias grátis, depois %@ por ano. 60 páginas de IA por mês, livros ilimitados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทดลองใช้ฟรี 3 วัน จากนั้นปีละ %@ ได้หน้า AI เดือนละ 60 หน้า ทำสมุดได้ไม่จำกัด"
          }
        }
      }
    },
