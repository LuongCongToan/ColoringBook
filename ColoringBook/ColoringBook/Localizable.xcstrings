    },
    "The PDF could not be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das PDF konnte nicht gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを保存できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o PDF."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก PDF ไม่ได้"
          }
        }
      }
    },
    "The book gets new, uncolored copies, so your child can color them again. My pages stay as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch bekommt neue, leere Kopien, damit dein Kind sie noch mal ausmalen kann. „Meine Seiten“ bleiben, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro recibe copias nuevas sin colorear para que tu hijo pueda colorearlas otra vez. Mis páginas se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le livre reçoit des copies neuves, non coloriées, pour que ton enfant puisse les colorier à nouveau. Mes pages restent telles quelles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックには色をぬる前の新しいコピーが入るので、お子さまがもう一度ぬれます。わたしのページはそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O livro recebe cópias novas, sem pintura, para seu filho pintar de novo. Minhas páginas continuam como estão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมุดจะได้สำเนาใหม่ที่ยังไม่ระบายสี ลูกจึงระบายได้อีกครั้ง ส่วน “หน้าของฉัน” ยังคงเหมือนเดิม"
          }
        }
      }
    },
    "The book shows the pages as they are colored now. Coloring a page in the book colors it in My pages too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch zeigt die Seiten so, wie sie jetzt ausgemalt sind. Was du im Buch ausmalst, ändert sich auch unter „Meine Seiten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro muestra las páginas tal como están coloreadas ahora. Si coloreas una página en el libro, también se colorea en Mis páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le livre montre les pages telles qu’elles sont coloriées maintenant. Colorier une page dans le livre la colorie aussi dans Mes pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックには、今ぬってある状態のページが入ります。ブックの中でぬると、わたしのページにも反映されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O livro mostra as páginas como estão pintadas agora. Pintar uma página no livro também a pinta em Minhas páginas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมุดจะแสดงหน้าตามที่ระบายไว้ตอนนี้ การระบายหน้าในสมุดจะเปลี่ยนหน้าใน “หน้าของฉัน” ด้วย"
          }
        }
      }
    },
    "The coloring cannot be brought back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben lassen sich nicht zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo coloreado no se podrá recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coloriage ne pourra pas être récupéré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぬった色はもとに戻せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pintura não poderá ser recuperada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีที่ระบายไว้จะกู้คืนไม่ได้"
          }
        }
      }
    },
    "The pages of this book could not be opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten dieses Buchs ließen sich nicht öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir las páginas de este libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir les pages de ce livre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブックのページを開けませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir as páginas deste livro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าของสมุดเล่มนี้ไม่ได้"
          }
        }
      }
    },
    "The pages stay in My pages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten bleiben unter „Meine Seiten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas se quedan en Mis páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages restent dans Mes pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは「わたしのページ」に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas continuam em Minhas páginas."
