    "Plans could not be loaded. Check the connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebote konnten nicht geladen werden. Prüf die Verbindung und versuch es noch mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los planes. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les formules. Vérifie la connexion et réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os planos. Verifique a conexão e tente de novo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดแพ็กเกจไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Please only use photos you have permission to use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte nutze nur Fotos, für die du die Erlaubnis hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo fotos para las que tengas permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’utilise que des photos que tu as le droit d’utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する許可のある写真だけを使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use apenas fotos que você tem permissão para usar."
