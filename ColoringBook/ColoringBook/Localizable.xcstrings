    "That purchase could not be verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf konnte nicht bestätigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar esa compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n’a pas pu être vérifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その購入を確認できませんでした。"
          }
        },
        "pt-BR": {
