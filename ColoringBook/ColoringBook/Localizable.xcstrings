        }
      }
    },
    "The App Store could not be reached. Check the connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüf die Verbindung und versuch es noch mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el App Store. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’App Store. Vérifie la connexion et réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a App Store. Verifique a conexão e tente de novo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ App Store ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        }
      }
    },
