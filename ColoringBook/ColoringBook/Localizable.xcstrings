{
  "sourceLanguage": "en",
  "strings": {
    "  ·  %lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld von %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld de %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld sur %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld / %lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld de %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "  ·  %lld จาก %lld"
          }
        }
      }
    },
    " It also leaves the %lld books that use it.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Die Seite wird auch aus dem Buch entfernt, das sie enthält."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Die Seite wird auch aus den %lld Büchern entfernt, die sie enthalten."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " También se quitará de %lld libro que la usa."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " También se quitará de los %lld libros que la usan."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Elle sera aussi retirée de %lld livre qui l’utilise."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Elle sera aussi retirée des %lld livres qui l’utilisent."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを使っている%lld冊のブックからも消えます。"
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Ela também será removida do %lld livro que a usa."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Ela também será removida dos %lld livros que a usam."
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " และจะหายไปจากสมุด %lld เล่มที่ใช้หน้านี้ด้วย"
          }
        }
      }
    },
    " It also leaves the book that uses it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Seite wird auch aus dem Buch entfernt, das sie enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " También se quitará del libro que la usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Elle sera aussi retirée du livre qui l’utilise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを使っているブックからも消えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Ela também será removida do livro que a usa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " และจะหายไปจากสมุดที่ใช้หน้านี้ด้วย"
          }
        }
      }
    },
    " Pages not made from a photo show the picture alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Seiten, die nicht aus einem Foto entstanden sind, zeigen nur das Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las páginas que no vienen de una foto muestran solo el dibujo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les pages qui ne viennent pas d’une photo montrent le dessin seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から作っていないページは、絵だけになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Páginas que não vieram de uma foto mostram só a imagem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " หน้าที่ไม่ได้ทำจากรูปถ่ายจะแสดงแค่ภาพระบายสี"
          }
        }
      }
    },
    " You can change one page’s layout inside the book.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Das Layout einzelner Seiten kannst du im Buch ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Puedes cambiar el diseño de una página dentro del libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tu peux changer la mise en page d’une seule page dans le livre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックの中で、1ページずつレイアウトを変えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Você pode mudar o layout de uma página dentro do livro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " เปลี่ยนรูปแบบของแต่ละหน้าได้ในสมุด"
          }
        }
      }
    },
