    "Something went wrong while drawing. Try again in a moment. No page was used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Malen ist etwas schiefgelaufen. Versuch es gleich noch mal. Es wurde keine Seite verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al dibujar. Inténtalo de nuevo en un momento. No se ha usado ninguna página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu pendant le dessin. Réessaie dans un instant. Aucune page n’a été utilisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描いている途中で問題が起きました。少し待ってから、もう一度お試しください。AIぬりえは使われていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao desenhar. Tente de novo daqui a pouco. Nenhuma página foi usada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดระหว่างวาด ลองใหม่อีกครั้งในอีกสักครู่ ครั้งนี้ไม่นับหน้า"
          }
        }
      }
    },
