<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only HTTPS through the system, so uploads skip the export
	     compliance question every time. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Finished "One Coloring Book" purchases stay in Transaction.all, so a
	     reinstall can ask the Worker for the pages left on each book
	     (docs/app-store-products.md). iOS 18+, which is why the app needs 18. -->
	<key>SKIncludeConsumableInAppPurchaseHistory</key>
	<true/>
	<!-- "Save Video" in the share sheet, for the book video (BookVideoMaker):
	     add-only, the app never reads the library this way. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saves your coloring book videos to your photos.</string>
	<!-- The app's cream paper and ink are drawn for a light page; in Dark
	     Mode system text turned white on cream (polish-plan 41). -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- The launch screen: the loading card on the app's cream (it was
	     plain white, polish-plan 39); LaunchSplash takes over and animates
	     it. Redraw LaunchCard with the DEBUG flag -renderLaunchCard. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchCard</string>
	</dict>
</dict>
</plist>
